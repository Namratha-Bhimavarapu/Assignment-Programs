#include <stdio.h>

int main()
{
 int mark;
 printf("enter your marks");
 scanf("%d",&mark);
 if(mark<0|| mark>100)
 printf("\n Invalid mark");
 else if(mark>=90)
 printf("\n grade O");
 else if(mark>=80)
 printf("\n grade A+");
 else if(mark>=70)
 printf("\n grade A");
 else if(mark>=60)
 printf("\n grade B");
 else if(mark>=50)
 printf("\n grade C");
 else
 printf("\n fail");
}